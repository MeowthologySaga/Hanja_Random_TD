{
  "name": "hanzi-random-tower-defense",
  "version": "0.27.0",
  "private": true,
  "description": "지역별 실제 한자 조합식으로 합성하는 20웨이브 랜덤 타워 디펜스",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4437",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests",
    "validate:data": "tsx scripts/validate-data.ts",
    "generate:learning": "node scripts/build-learning-readings.mjs",
    "generate:radicals": "node scripts/build-hanzi-radicals.mjs",
    "simulate": "tsx scripts/simulate.ts",
    "test:e2e": "playwright test",
    "check": "npm run validate:data && npm run test && npm run simulate -- --runs=45 && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
