{
  "name": "hanzi-random-tower-defense",
  "version": "0.33.0",
  "private": true,
  "description": "전략 조합전과 획수 기반 캐주얼 8성전을 갖춘 100웨이브 한자 랜덤 타워 디펜스",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4437",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-dist.mjs",
    "test": "vitest run tests",
    "validate:data": "tsx scripts/validate-data.ts",
    "audit:huneum": "node scripts/sync-korean-huneum.mjs",
    "generate:learning": "node scripts/build-learning-readings.mjs",
    "generate:radicals": "node scripts/build-hanzi-radicals.mjs",
    "generate:strokes": "node scripts/build-hanzi-strokes.mjs",
    "integrate:jaryeongs": "tsx scripts/integrate-generated-jaryeongs.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test:e2e": "playwright test",
    "check": "npm run audit:huneum && npm run validate:data && npm run test && npm run simulate -- --runs=45 && npm run build"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
